# Copy to tests/local.env (gitignored) and fill in for your machine.
# Real environment variables and pytest options (--bitness, --x64dbg-path) take precedence.

# x64dbg "release" directory, the one containing x32/ and x64/.
# The debugger is derived per bitness: <dir>\x64\x64dbg.exe or <dir>\x32\x32dbg.exe
X64DBG_RELEASE_DIR=C:\path\to\x64dbg\release

# Or pin one exact executable instead (wins over X64DBG_RELEASE_DIR):
# X64DBG_PATH=C:\path\to\x64dbg\release\x64\x64dbg.exe

# Default bitness when --bitness isn't passed (32 or 64).
# TEST_BITNESS=64

# Remote functional test (tests/run_functional_tests.ps1, tests/test_functional_remote.py)
# REMOTE_HOST=192.0.2.10
# REMOTE_REQ_PORT=27066
# REMOTE_PUB_PORT=27067
